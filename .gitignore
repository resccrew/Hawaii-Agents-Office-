# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Node / Next.js
node_modules/
.next/
.turbo/
*.tsbuildinfo
out/

# PyInstaller sidecar build output — build_sidecar.py regenerates these;
# only the target-triple binary it copies into src-tauri/binaries/ matters,
# and even that's a build artifact (not committed either, see below).
backend/build/
backend/dist/

# Tauri / Rust build output and the sidecar binaries it bundles — both are
# regenerated by `python backend/build_sidecar.py` + `cargo tauri build`,
# not source.
src-tauri/target/
src-tauri/binaries/

# Runtime data — spawned agent workspaces contain live session transcripts
# and per-agent mcp-config.json, not source code. state/ is the
# AgentRegistry/TaskBoard JSON persistence snapshot, same reasoning.
agent-workspaces/
state/
chat-uploads/

# Repos cloned locally through the git bar's "connect a GitHub repo" flow
# (backend/app/core/git_ops.py's select_github_repo) — someone else's
# working tree, not part of this project. Was untracked-but-not-ignored
# before, which is exactly what makes `git add -A` in git_ops.push()
# dangerous: the default active repo on first run is studio-ops itself, so
# an un-ignored clone sitting in here would get staged as a broken gitlink
# on the next push.
repos/

# Playwright MCP test debris (screenshots, console logs from manual browser testing)
.playwright-mcp/

# OS
.DS_Store

# Local env / secrets (none currently checked in, but guard against it)
.env
.env.local
*.env
*.log
