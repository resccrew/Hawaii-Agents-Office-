{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hawaii Agents Office",
  "version": "0.1.0",
  "identifier": "com.studioops.desktop",
  "build": {
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../frontend"
    },
    "beforeDevCommand": "",
    "frontendDist": "../frontend/out",
    "devUrl": "http://localhost:3010"
  },
  "app": {
    "windows": [
      {
        "title": "Hawaii Agents Office",
        "width": 1100,
        "height": 700,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "exceptionDomain": "localhost"
    },
    "externalBin": ["binaries/studio-ops-backend"]
  }
}
